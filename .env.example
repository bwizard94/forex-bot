# ---------------------------------------------------------------------------
# Forex Sentinel — copy this file to .env and fill in secrets.
# Never commit real tokens. The bot auto-discovers the OANDA account ID
# when OANDA_ACCOUNT_ID is left blank.
# ---------------------------------------------------------------------------

# --- Market data (Twelve Data OHLCV backup) ---
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- Market data (CurrencyFreaks independent FX mids / quote fallback) ---
CURRENCYFREAKS_API_KEY=
CURRENCYFREAKS_BASE_URL=https://api.currencyfreaks.com
REFERENCE_QUOTE_TTL_SECONDS=300
QUOTE_WARN_PIPS=8

# --- Paper trading (OANDA v20 Practice) ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Slack (optional — alerts are logged + shown on the dashboard if unset) ---
# Bot token (xoxb-...) posts Block Kit into #forex. Incoming webhooks also work
# if the webhook was created for that channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=forex
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=

# --- Database ---
# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg2://user:pass@localhost:5432/forex
DATABASE_URL=sqlite:///./data/forex_bot.db

# --- Watchlist & timeframes ---
WATCHLIST=EUR/USD
TRADING_STYLE=scalp
SIGNAL_TIMEFRAME=M5
HTF_BIAS_TIMEFRAME=H1
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
ATR_PERIOD=14
BB_PERIOD=20
BB_STD=2.0
SESSION_FILTER=true
TRADE_SESSION_START_HOUR=0
TRADE_SESSION_END_HOUR=22
REQUIRE_HTF_TREND=true
MIN_ATR_PIPS=0.8
MIN_STOP_PIPS=5.0
SCALP_MAX_SPREAD_PIPS=1.8
SCALP_MAX_HOLD_MINUTES=90

# --- Risk (Ox scalp: short SL/TP, 0.6% base) ---
RISK_PER_TRADE_PCT=0.006
DAILY_LOSS_LIMIT_PCT=0.03
DAILY_REDUCE_AT_PCT=0.001
DAILY_SOFT_HALT_PCT=0.0025
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=3
MAX_SAME_SIDE_POSITIONS=2
MAX_OPEN_RISK_PCT=0.025
CONVICTION_RISK_PCT=0.009
CONVICTION_STRENGTH_MIN=68
ADDON_RISK_PCT=0.004
FADE_RISK_PCT=0.004
FADE_STRENGTH_MIN=76
MAX_UNITS_PER_TRADE=100000
MIN_CONFLUENCE=2
ATR_SL_MULTIPLIER=1.0
ATR_TP1_MULTIPLIER=1.2
ATR_TP2_MULTIPLIER=2.0
MIN_RR_RATIO=1.15

# --- Lessons (tighten or skip fingerprints that keep losing) ---
LESSON_LOOKBACK_DAYS=14
LESSON_LOSS_HIGH_STRENGTH=1
LESSON_LOSS_SKIP=2
LESSON_SKIP_HOURS=72
LESSON_HIGH_STRENGTH_MIN=68
LESSON_SCRATCH_USD=2.0
FAMILY_LOSS_SKIP=2
POST_LOSS_COOLDOWN_MINUTES=4
REENTRY_COOLDOWN_MINUTES=2
MAX_CONSECUTIVE_LOSSES=2

# --- EUR/USD desk notes (UTC, weekdays) ---
NEWS_BLACKOUT_MINUTES=30
BRIEFING_HOUR=8
BRIEFING_MINUTE=0
RECAP_HOUR=23
RECAP_MINUTE=30
NEWS_SCAN_HOUR=5
NEWS_SCAN_MINUTE=0
SLACK_PULSE_MINUTES=15
INTEL_INTERVAL_MINUTES=20
TAVILY_API_KEY=

# --- Google Sheets (via Composio — optional) ---
# Create an API key at https://platform.composio.dev and paste it here (or
# on the hub Overview) so the live process can keep the trade workbook in
# sync. Leave GOOGLE_SHEETS_SPREADSHEET_ID blank to create the book on first
# successful push. See desk/SHEETS.md.
COMPOSIO_API_KEY=
COMPOSIO_CONNECTED_ACCOUNT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SPREADSHEET_URL=
SHEETS_SYNC_ENABLED=true

# --- MetaTrader 4 demo (optional second book beside OANDA) ---
# Paste login/password/server on the hub Overview, or set them here.
# Cloud Linux cannot run MT4.exe. Copies go out through MetaApi (if
# METAAPI_TOKEN is set), the bundled EA polling /api/mt4/bridge, or a
# local ledger until one of those is live. Magic 212100. Operator tickets
# with any other magic stay hands-off. See desk/MT4.md.
MT4_ENABLED=true
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=
MT4_BRIDGE_SECRET=
MT4_MAGIC=212100
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=new-york

# Extra historical OHLCV for the desk to study. Relative paths are from the
# project root. On your machine the desk also reads Desktop/extra datasets.
# A cloud agent cannot see your local Desktop.
EXTRA_DATASETS_DIR=extra datasets

# --- Runtime ---
ENABLE_TRADING=false
LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
FETCH_INTERVAL_SECONDS=60
TZ=UTC

# Practice policy switches (opt in deliberately; these are not credentials)
PRACTICE_DAILY_LOSS_HALT_ENABLED=true
PRACTICE_CONTEXTUAL_LOSS_REVIEW=false
STRATEGY_RESEARCH_ONLY=false
